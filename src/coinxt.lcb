/* coinxt.lcb - the CoinXT foreign-handler module (the FFI seam).

   This is the ONLY file that touches the C shim (native/coinxt.c, the cnx_
   ABI over vendored trezor-crypto). It follows the family FFI law (CLAUDE.md)
   and mirrors, construct for construct, the conventions the SodiumXT binding
   (src/sodium.lcb, VERIFIED ON-ENGINE) settled against a real OXT compile and
   a crash audit:

   - byte buffers cross as Pointer + length. An LCB Data does NOT auto-bridge
     to void*: an IN buffer passes MCDataGetBytePtr(theData) plus its
     MCDataGetLength, an OUT buffer is a raw engine MCMemoryAllocate block
     passed as a real Pointer, copied back with MCDataCreateWithBytes and then
     deallocated.
   - MCMemoryAllocate's size is C size_t, so it marshals as UIntSize, NOT
     CUInt. MCDataGetLength / MCDataCreateWithBytes use the engine's uindex_t,
     which is 32-bit, so THOSE are CUInt (the reverse trap).
   - the cnx_ ABI's own lengths are C size_t, so they marshal as UIntSize
     (unlike SodiumXT's sxt_ ABI, whose lengths are C int -> CInt).
   - every foreign call is bracketed by unsafe ... end unsafe.
   - every cnx_ function returns an int status (0 ok, negative error); the
     mapping to a human-readable error is done ONCE here (cnxThrow) and every
     public handler throws a "CoinXT: ..." string the script layer catches.
   - every buffer length comes from a cnx_*_len() function, never a hardcoded
     number: the shim owns the sizes, cxbCheckABI gates a stale binary.
   - fixed-size arguments (a seckey, a digest, a signature) are length-checked
     HERE before the call, because the C side reads exactly that many bytes
     and trusts this layer (the documented ABI contract).

   Secret hygiene: an out-buffer that carried a secret (a PBKDF2-derived key,
   the ECDH shared secret; HD seckeys in a later phase) is wiped via cnx_wipe
   BEFORE it is deallocated (cnxTakeSecret). Inbound key Data is the caller's;
   the script layer clears its own variables (see src/coinxt.livecodescript).

   Library resolution: the native library ships bundled INSIDE the packaged
   extension as src/code/<arch>-<platform>/coinxt.{so,dll,dylib} with the bare
   token name (no "lib" prefix), so the engine resolves the "c:coinxt>..."
   bind strings via the revLibraryMapping with no loose library and no
   LD_LIBRARY_PATH (the SodiumXT / TorrentXT packaging model;
   tools/package-extension.py stages it, CI refreshes it).

   NEEDS AN ON-ENGINE PASS (no headless OXT compiler exists). One deliberate
   divergence from the proven sodium.lcb to confirm on-engine: cnxDataPtr
   never calls MCDataGetBytePtr on an EMPTY Data (length 0 substitutes a
   1-byte module-lifetime sentinel), because the empty case's byte pointer is
   engine-defined and the shim never reads a zero-length buffer anyway. */

library org.openxtalk.library.coinxt

use com.livecode.foreign
use com.livecode.string
use com.livecode.arithmetic

metadata version    is "0.1.0"
metadata author     is "OpenXTalk"
metadata title      is "CoinXT"
metadata summary    is "Bitcoin and Ethereum cryptography for xTalk via trezor-crypto (secp256k1 keys, RFC 6979 ECDSA, recoverable signatures and ecrecover, ECDH, SHA-2/SHA-3/Keccak-256/RIPEMD-160, HMAC, PBKDF2)."

/* the .lcb and the shim ship as one unit; any skew means a stale binary and
   is caught by cxbCheckABI before a call could corrupt memory. Keep in step
   with CNX_ABI_VERSION in native/coinxt.c. */
constant kAbiVersion is 2

/* --------------------------------------------------------------------------
   Engine memory + Data bridges (resolve by NAME, so NO leading underscore).
   -------------------------------------------------------------------------- */

foreign handler MCMemoryAllocate(in pSize as UIntSize, out rPtr as Pointer) returns CBool binds to "<builtin>"
foreign handler MCMemoryDeallocate(in pPtr as Pointer) returns nothing binds to "<builtin>"
foreign handler MCDataGetBytePtr(in pData as Data) returns Pointer binds to "<builtin>"
foreign handler MCDataGetLength(in pData as Data) returns CUInt binds to "<builtin>"
foreign handler MCDataCreateWithBytes(in pBytes as Pointer, in pLen as CUInt, out rData as Data) returns CBool binds to "<builtin>"

/* --------------------------------------------------------------------------
   The cnx_ ABI (stable exported symbols, never renamed once shipped).
   Private _cnx_* names here; the bind strings carry the real symbol.
   -------------------------------------------------------------------------- */

foreign handler _cnx_abi_version() returns CInt binds to "c:coinxt>cnx_abi_version"

foreign handler _cnx_keccak256_len() returns UIntSize binds to "c:coinxt>cnx_keccak256_len"
foreign handler _cnx_sha3_256_len() returns UIntSize binds to "c:coinxt>cnx_sha3_256_len"
foreign handler _cnx_sha256_len() returns UIntSize binds to "c:coinxt>cnx_sha256_len"
foreign handler _cnx_sha512_len() returns UIntSize binds to "c:coinxt>cnx_sha512_len"
foreign handler _cnx_ripemd160_len() returns UIntSize binds to "c:coinxt>cnx_ripemd160_len"
foreign handler _cnx_hmac_sha256_len() returns UIntSize binds to "c:coinxt>cnx_hmac_sha256_len"
foreign handler _cnx_hmac_sha512_len() returns UIntSize binds to "c:coinxt>cnx_hmac_sha512_len"
foreign handler _cnx_seckey_len() returns UIntSize binds to "c:coinxt>cnx_seckey_len"
foreign handler _cnx_pubkey_len_compressed() returns UIntSize binds to "c:coinxt>cnx_pubkey_len_compressed"
foreign handler _cnx_pubkey_len_uncompressed() returns UIntSize binds to "c:coinxt>cnx_pubkey_len_uncompressed"
foreign handler _cnx_ecdsa_sig_len() returns UIntSize binds to "c:coinxt>cnx_ecdsa_sig_len"
foreign handler _cnx_recoverable_sig_len() returns UIntSize binds to "c:coinxt>cnx_recoverable_sig_len"
foreign handler _cnx_digest_len() returns UIntSize binds to "c:coinxt>cnx_digest_len"
foreign handler _cnx_ecdh_secret_len() returns UIntSize binds to "c:coinxt>cnx_ecdh_secret_len"

foreign handler _cnx_keccak256(in pIn as Pointer, in pInLen as UIntSize, in pOut as Pointer) returns CInt binds to "c:coinxt>cnx_keccak256"
foreign handler _cnx_sha3_256(in pIn as Pointer, in pInLen as UIntSize, in pOut as Pointer) returns CInt binds to "c:coinxt>cnx_sha3_256"
foreign handler _cnx_sha256(in pIn as Pointer, in pInLen as UIntSize, in pOut as Pointer) returns CInt binds to "c:coinxt>cnx_sha256"
foreign handler _cnx_sha512(in pIn as Pointer, in pInLen as UIntSize, in pOut as Pointer) returns CInt binds to "c:coinxt>cnx_sha512"
foreign handler _cnx_ripemd160(in pIn as Pointer, in pInLen as UIntSize, in pOut as Pointer) returns CInt binds to "c:coinxt>cnx_ripemd160"
foreign handler _cnx_hmac_sha256(in pKey as Pointer, in pKeyLen as UIntSize, in pMsg as Pointer, in pMsgLen as UIntSize, in pOut as Pointer) returns CInt binds to "c:coinxt>cnx_hmac_sha256"
foreign handler _cnx_hmac_sha512(in pKey as Pointer, in pKeyLen as UIntSize, in pMsg as Pointer, in pMsgLen as UIntSize, in pOut as Pointer) returns CInt binds to "c:coinxt>cnx_hmac_sha512"
foreign handler _cnx_pbkdf2_hmac_sha512(in pPw as Pointer, in pPwLen as UIntSize, in pSalt as Pointer, in pSaltLen as UIntSize, in pIters as CInt, in pOut as Pointer, in pOutLen as UIntSize) returns CInt binds to "c:coinxt>cnx_pbkdf2_hmac_sha512"

foreign handler _cnx_seckey_verify(in pSk as Pointer) returns CInt binds to "c:coinxt>cnx_seckey_verify"
foreign handler _cnx_pubkey_from_seckey(in pSk as Pointer, in pCompressed as CInt, in pOut as Pointer) returns CInt binds to "c:coinxt>cnx_pubkey_from_seckey"
foreign handler _cnx_pubkey_decompress(in pPub as Pointer, in pPubLen as UIntSize, in pOut as Pointer) returns CInt binds to "c:coinxt>cnx_pubkey_decompress"
foreign handler _cnx_ecdsa_sign(in pSk as Pointer, in pHash as Pointer, in pOut as Pointer) returns CInt binds to "c:coinxt>cnx_ecdsa_sign"
foreign handler _cnx_ecdsa_verify(in pPub as Pointer, in pPubLen as UIntSize, in pHash as Pointer, in pSig as Pointer) returns CInt binds to "c:coinxt>cnx_ecdsa_verify"
foreign handler _cnx_ecdsa_sign_recoverable(in pSk as Pointer, in pHash as Pointer, in pOut as Pointer) returns CInt binds to "c:coinxt>cnx_ecdsa_sign_recoverable"
foreign handler _cnx_ecdsa_recover(in pSig as Pointer, in pHash as Pointer, in pOut as Pointer) returns CInt binds to "c:coinxt>cnx_ecdsa_recover"
foreign handler _cnx_ecdh(in pSk as Pointer, in pPub as Pointer, in pPubLen as UIntSize, in pOut as Pointer) returns CInt binds to "c:coinxt>cnx_ecdh"
foreign handler _cnx_wipe(in pBuf as Pointer, in pLen as UIntSize) returns CInt binds to "c:coinxt>cnx_wipe"

/* a 1-byte module-lifetime block substituted for the byte pointer of an EMPTY
   Data (whose real byte pointer is engine-defined and may be null; a plain
   Pointer rejects nothing, and the shim never reads a zero-length buffer) */
variable sEmptySentinel as optional Pointer

/* --------------------------------------------------------------------------
   Private marshalling helpers.
   -------------------------------------------------------------------------- */

/* map a cnx_ status code to one thrown "CoinXT: ..." string; pWhat names the
   operation so the app's catch shows where it failed */
private handler cnxThrow(in pRc as Integer, in pWhat as String) returns nothing
   if pRc is -1 then
      throw "CoinXT: " & pWhat & ": a required buffer was missing (engine-level bug)"
   else if pRc is -2 then
      throw "CoinXT: " & pWhat & ": a buffer has the wrong length"
   else if pRc is -3 then
      throw "CoinXT: " & pWhat & ": invalid key (seckey out of range, or pubkey not on the curve)"
   else if pRc is -4 then
      throw "CoinXT: " & pWhat & ": invalid signature"
   else if pRc is -5 then
      throw "CoinXT: " & pWhat & ": a numeric argument is out of range"
   else
      throw "CoinXT: " & pWhat & ": internal native error (rejected validated input)"
   end if
end handler

private handler cnxAlloc(in pCap as Integer) returns Pointer
   variable tPtr as Pointer
   variable tOk as CBool
   unsafe
      put MCMemoryAllocate(pCap, tPtr) into tOk
   end unsafe
   if not tOk then
      throw "CoinXT: out of memory allocating an output buffer"
   end if
   return tPtr
end handler

private handler cnxFree(in pPtr as Pointer) returns nothing
   unsafe
      MCMemoryDeallocate(pPtr)
   end unsafe
end handler

private handler cnxDataLen(in pData as Data) returns Integer
   variable tLen as Integer
   unsafe
      put MCDataGetLength(pData) into tLen
   end unsafe
   return tLen
end handler

/* IN-buffer view of a Data value. An EMPTY Data never reaches
   MCDataGetBytePtr at all: it gets the shared 1-byte sentinel instead, which
   the shim never dereferences because the passed length is 0. */
private handler cnxDataPtr(in pData as Data) returns Pointer
   variable tPtr as Pointer
   if cnxDataLen(pData) is 0 then
      if sEmptySentinel is nothing then
         put cnxAlloc(1) into sEmptySentinel
      end if
      return sEmptySentinel
   end if
   unsafe
      put MCDataGetBytePtr(pData) into tPtr
   end unsafe
   return tPtr
end handler

/* the C side reads exactly the advertised byte count of every fixed-size
   argument, so a wrong-length Data must be stopped HERE, before the call */
private handler cnxCheckLen(in pData as Data, in pWant as Integer, in pWhat as String) returns nothing
   if cnxDataLen(pData) is not pWant then
      throw "CoinXT: " & pWhat & ": wrong length"
   end if
end handler

/* a pubkey is 33 (02/03 compressed) or 65 (04 uncompressed) bytes; anything
   else fails closed here and the prefix/point checks fail closed in C */
private handler cnxCheckPubLen(in pPub as Data, in pWhat as String) returns nothing
   variable tLen as Integer
   variable tLen33 as Integer
   variable tLen65 as Integer
   put cnxDataLen(pPub) into tLen
   unsafe
      put _cnx_pubkey_len_compressed() into tLen33
      put _cnx_pubkey_len_uncompressed() into tLen65
   end unsafe
   if tLen is not tLen33 and tLen is not tLen65 then
      throw "CoinXT: " & pWhat & ": a pubkey must be 33 or 65 bytes"
   end if
end handler

/* copy an out-block into a Data value and free the block (non-secret path) */
private handler cnxTake(in pPtr as Pointer, in pLen as Integer) returns Data
   variable tData as Data
   variable tOk as CBool
   unsafe
      put MCDataCreateWithBytes(pPtr, pLen, tData) into tOk
      MCMemoryDeallocate(pPtr)
   end unsafe
   if not tOk then
      throw "CoinXT: could not build result data"
   end if
   return tData
end handler

/* same, but the block carried a secret: wipe it BEFORE deallocation so the
   bytes do not linger in freed heap */
private handler cnxTakeSecret(in pPtr as Pointer, in pLen as Integer) returns Data
   variable tData as Data
   variable tOk as CBool
   unsafe
      put MCDataCreateWithBytes(pPtr, pLen, tData) into tOk
      _cnx_wipe(pPtr, pLen)
      MCMemoryDeallocate(pPtr)
   end unsafe
   if not tOk then
      throw "CoinXT: could not build result data"
   end if
   return tData
end handler

/* shared shape of every one-shot hash: in-Data, fixed-size out */
private handler cnxHashCall(in pWhich as String, in pData as Data, in pOutLen as Integer) returns Data
   variable tRc as Integer
   variable tIn as Pointer
   variable tOut as Pointer
   variable tInLen as Integer
   put cnxDataPtr(pData) into tIn
   put cnxDataLen(pData) into tInLen
   put cnxAlloc(pOutLen) into tOut
   unsafe
      if pWhich is "keccak256" then
         put _cnx_keccak256(tIn, tInLen, tOut) into tRc
      else if pWhich is "sha3_256" then
         put _cnx_sha3_256(tIn, tInLen, tOut) into tRc
      else if pWhich is "sha256" then
         put _cnx_sha256(tIn, tInLen, tOut) into tRc
      else if pWhich is "sha512" then
         put _cnx_sha512(tIn, tInLen, tOut) into tRc
      else
         put _cnx_ripemd160(tIn, tInLen, tOut) into tRc
      end if
   end unsafe
   if tRc is not 0 then
      cnxFree(tOut)
      cnxThrow(tRc, pWhich)
   end if
   return cnxTake(tOut, pOutLen)
end handler

/* --------------------------------------------------------------------------
   Public surface (the script layer's cx* wraps exactly these).
   -------------------------------------------------------------------------- */

/* throws on ABI skew so a stale native binary is caught BEFORE any call that
   could corrupt memory; the app tells the user to reinstall CoinXT */
public handler cxbCheckABI() returns nothing
   variable tGot as Integer
   unsafe
      put _cnx_abi_version() into tGot
   end unsafe
   if tGot is not kAbiVersion then
      throw "CoinXT: native shim ABI mismatch; reinstall the packaged CoinXT extension (script and binary versions differ)"
   end if
end handler

public handler cxbKeccak256(in pData as Data) returns Data
   variable tLen as Integer
   unsafe
      put _cnx_keccak256_len() into tLen
   end unsafe
   return cnxHashCall("keccak256", pData, tLen)
end handler

public handler cxbSha3_256(in pData as Data) returns Data
   variable tLen as Integer
   unsafe
      put _cnx_sha3_256_len() into tLen
   end unsafe
   return cnxHashCall("sha3_256", pData, tLen)
end handler

public handler cxbSha256(in pData as Data) returns Data
   variable tLen as Integer
   unsafe
      put _cnx_sha256_len() into tLen
   end unsafe
   return cnxHashCall("sha256", pData, tLen)
end handler

public handler cxbSha512(in pData as Data) returns Data
   variable tLen as Integer
   unsafe
      put _cnx_sha512_len() into tLen
   end unsafe
   return cnxHashCall("sha512", pData, tLen)
end handler

public handler cxbRipemd160(in pData as Data) returns Data
   variable tLen as Integer
   unsafe
      put _cnx_ripemd160_len() into tLen
   end unsafe
   return cnxHashCall("ripemd160", pData, tLen)
end handler

public handler cxbHmacSha256(in pKey as Data, in pMsg as Data) returns Data
   variable tRc as Integer
   variable tLen as Integer
   variable tKeyLen as Integer
   variable tMsgLen as Integer
   variable tKeyPtr as Pointer
   variable tMsgPtr as Pointer
   variable tOut as Pointer
   put cnxDataPtr(pKey) into tKeyPtr
   put cnxDataPtr(pMsg) into tMsgPtr
   put cnxDataLen(pKey) into tKeyLen
   put cnxDataLen(pMsg) into tMsgLen
   unsafe
      put _cnx_hmac_sha256_len() into tLen
   end unsafe
   put cnxAlloc(tLen) into tOut
   unsafe
      put _cnx_hmac_sha256(tKeyPtr, tKeyLen, tMsgPtr, tMsgLen, tOut) into tRc
   end unsafe
   if tRc is not 0 then
      cnxFree(tOut)
      cnxThrow(tRc, "hmac-sha256")
   end if
   return cnxTake(tOut, tLen)
end handler

public handler cxbHmacSha512(in pKey as Data, in pMsg as Data) returns Data
   variable tRc as Integer
   variable tLen as Integer
   variable tKeyLen as Integer
   variable tMsgLen as Integer
   variable tKeyPtr as Pointer
   variable tMsgPtr as Pointer
   variable tOut as Pointer
   put cnxDataPtr(pKey) into tKeyPtr
   put cnxDataPtr(pMsg) into tMsgPtr
   put cnxDataLen(pKey) into tKeyLen
   put cnxDataLen(pMsg) into tMsgLen
   unsafe
      put _cnx_hmac_sha512_len() into tLen
   end unsafe
   put cnxAlloc(tLen) into tOut
   unsafe
      put _cnx_hmac_sha512(tKeyPtr, tKeyLen, tMsgPtr, tMsgLen, tOut) into tRc
   end unsafe
   if tRc is not 0 then
      cnxFree(tOut)
      cnxThrow(tRc, "hmac-sha512")
   end if
   return cnxTake(tOut, tLen)
end handler

/* the derived key can carry key material (a BIP-39 seed), so the out-block
   takes the secret path */
public handler cxbPbkdf2HmacSha512(in pPw as Data, in pSalt as Data, in pIters as Integer, in pOutLen as Integer) returns Data
   variable tRc as Integer
   variable tPwLen as Integer
   variable tSaltLen as Integer
   variable tPwPtr as Pointer
   variable tSaltPtr as Pointer
   variable tOut as Pointer
   if pIters < 1 then
      throw "CoinXT: pbkdf2: iterations must be at least 1"
   end if
   if pOutLen < 1 then
      throw "CoinXT: pbkdf2: output length must be at least 1"
   end if
   put cnxDataPtr(pPw) into tPwPtr
   put cnxDataPtr(pSalt) into tSaltPtr
   put cnxDataLen(pPw) into tPwLen
   put cnxDataLen(pSalt) into tSaltLen
   put cnxAlloc(pOutLen) into tOut
   unsafe
      put _cnx_pbkdf2_hmac_sha512(tPwPtr, tPwLen, tSaltPtr, tSaltLen, pIters, tOut, pOutLen) into tRc
      if tRc is not 0 then
         _cnx_wipe(tOut, pOutLen)
      end if
   end unsafe
   if tRc is not 0 then
      cnxFree(tOut)
      cnxThrow(tRc, "pbkdf2")
   end if
   return cnxTakeSecret(tOut, pOutLen)
end handler

/* true for a scalar in [1, n-1]; false otherwise (fail closed) */
public handler cxbSeckeyVerify(in pSk as Data) returns Boolean
   variable tRc as Integer
   variable tSkPtr as Pointer
   variable tLen as Integer
   unsafe
      put _cnx_seckey_len() into tLen
   end unsafe
   if cnxDataLen(pSk) is not tLen then
      return false
   end if
   put cnxDataPtr(pSk) into tSkPtr
   unsafe
      put _cnx_seckey_verify(tSkPtr) into tRc
   end unsafe
   if tRc is 0 then
      return true
   end if
   return false
end handler

public handler cxbPubkeyFromSeckey(in pSk as Data, in pCompressed as Boolean) returns Data
   variable tRc as Integer
   variable tSkPtr as Pointer
   variable tOut as Pointer
   variable tOutLen as Integer
   variable tSkLen as Integer
   variable tFlag as Integer
   unsafe
      put _cnx_seckey_len() into tSkLen
      if pCompressed then
         put _cnx_pubkey_len_compressed() into tOutLen
      else
         put _cnx_pubkey_len_uncompressed() into tOutLen
      end if
   end unsafe
   cnxCheckLen(pSk, tSkLen, "public key derivation")
   put 0 into tFlag
   if pCompressed then
      put 1 into tFlag
   end if
   put cnxDataPtr(pSk) into tSkPtr
   put cnxAlloc(tOutLen) into tOut
   unsafe
      put _cnx_pubkey_from_seckey(tSkPtr, tFlag, tOut) into tRc
   end unsafe
   if tRc is not 0 then
      cnxFree(tOut)
      cnxThrow(tRc, "public key derivation")
   end if
   return cnxTake(tOut, tOutLen)
end handler

public handler cxbPubkeyDecompress(in pPub as Data) returns Data
   variable tRc as Integer
   variable tPubPtr as Pointer
   variable tPubLen as Integer
   variable tOut as Pointer
   variable tOutLen as Integer
   cnxCheckPubLen(pPub, "pubkey decompress")
   unsafe
      put _cnx_pubkey_len_uncompressed() into tOutLen
   end unsafe
   put cnxDataPtr(pPub) into tPubPtr
   put cnxDataLen(pPub) into tPubLen
   put cnxAlloc(tOutLen) into tOut
   unsafe
      put _cnx_pubkey_decompress(tPubPtr, tPubLen, tOut) into tRc
   end unsafe
   if tRc is not 0 then
      cnxFree(tOut)
      cnxThrow(tRc, "pubkey decompress")
   end if
   return cnxTake(tOut, tOutLen)
end handler

/* deterministic ECDSA (RFC 6979) over the caller's 32-byte digest; the
   result is 64 bytes r||s, always low-s */
public handler cxbEcdsaSign(in pSk as Data, in pHash as Data) returns Data
   variable tRc as Integer
   variable tSkPtr as Pointer
   variable tHashPtr as Pointer
   variable tOut as Pointer
   variable tOutLen as Integer
   variable tSkLen as Integer
   variable tHashLen as Integer
   unsafe
      put _cnx_seckey_len() into tSkLen
      put _cnx_digest_len() into tHashLen
      put _cnx_ecdsa_sig_len() into tOutLen
   end unsafe
   cnxCheckLen(pSk, tSkLen, "sign")
   cnxCheckLen(pHash, tHashLen, "sign")
   put cnxDataPtr(pSk) into tSkPtr
   put cnxDataPtr(pHash) into tHashPtr
   put cnxAlloc(tOutLen) into tOut
   unsafe
      put _cnx_ecdsa_sign(tSkPtr, tHashPtr, tOut) into tRc
   end unsafe
   if tRc is not 0 then
      cnxFree(tOut)
      cnxThrow(tRc, "sign")
   end if
   return cnxTake(tOut, tOutLen)
end handler

/* true only for a signature that verifies; every malformed input is false
   (fail closed), never an error the caller could mistake for success */
public handler cxbEcdsaVerify(in pPub as Data, in pHash as Data, in pSig as Data) returns Boolean
   variable tRc as Integer
   variable tPubPtr as Pointer
   variable tHashPtr as Pointer
   variable tSigPtr as Pointer
   variable tHashLen as Integer
   variable tSigLen as Integer
   variable tPubLen as Integer
   variable tLen33 as Integer
   variable tLen65 as Integer
   unsafe
      put _cnx_digest_len() into tHashLen
      put _cnx_ecdsa_sig_len() into tSigLen
      put _cnx_pubkey_len_compressed() into tLen33
      put _cnx_pubkey_len_uncompressed() into tLen65
   end unsafe
   if cnxDataLen(pHash) is not tHashLen then
      return false
   end if
   if cnxDataLen(pSig) is not tSigLen then
      return false
   end if
   put cnxDataLen(pPub) into tPubLen
   if tPubLen is not tLen33 and tPubLen is not tLen65 then
      return false
   end if
   put cnxDataPtr(pPub) into tPubPtr
   put cnxDataPtr(pHash) into tHashPtr
   put cnxDataPtr(pSig) into tSigPtr
   unsafe
      put _cnx_ecdsa_verify(tPubPtr, tPubLen, tHashPtr, tSigPtr) into tRc
   end unsafe
   if tRc is 0 then
      return true
   end if
   return false
end handler

/* Ethereum's shape: 65 bytes r||s||recid with recid RAW 0..3 (mapping to
   v = 27/28 or EIP-155 is presentation and stays in the script layer) */
public handler cxbEcdsaSignRecoverable(in pSk as Data, in pHash as Data) returns Data
   variable tRc as Integer
   variable tSkPtr as Pointer
   variable tHashPtr as Pointer
   variable tOut as Pointer
   variable tOutLen as Integer
   variable tSkLen as Integer
   variable tHashLen as Integer
   unsafe
      put _cnx_seckey_len() into tSkLen
      put _cnx_digest_len() into tHashLen
      put _cnx_recoverable_sig_len() into tOutLen
   end unsafe
   cnxCheckLen(pSk, tSkLen, "sign recoverable")
   cnxCheckLen(pHash, tHashLen, "sign recoverable")
   put cnxDataPtr(pSk) into tSkPtr
   put cnxDataPtr(pHash) into tHashPtr
   put cnxAlloc(tOutLen) into tOut
   unsafe
      put _cnx_ecdsa_sign_recoverable(tSkPtr, tHashPtr, tOut) into tRc
   end unsafe
   if tRc is not 0 then
      cnxFree(tOut)
      cnxThrow(tRc, "sign recoverable")
   end if
   return cnxTake(tOut, tOutLen)
end handler

/* ecrecover: expects the RAW recid (0..3) in byte 65; returns the 65-byte
   uncompressed signer pubkey */
public handler cxbEcdsaRecover(in pSig as Data, in pHash as Data) returns Data
   variable tRc as Integer
   variable tSigPtr as Pointer
   variable tHashPtr as Pointer
   variable tOut as Pointer
   variable tOutLen as Integer
   variable tSigLen as Integer
   variable tHashLen as Integer
   unsafe
      put _cnx_recoverable_sig_len() into tSigLen
      put _cnx_digest_len() into tHashLen
      put _cnx_pubkey_len_uncompressed() into tOutLen
   end unsafe
   cnxCheckLen(pSig, tSigLen, "recover")
   cnxCheckLen(pHash, tHashLen, "recover")
   put cnxDataPtr(pSig) into tSigPtr
   put cnxDataPtr(pHash) into tHashPtr
   put cnxAlloc(tOutLen) into tOut
   unsafe
      put _cnx_ecdsa_recover(tSigPtr, tHashPtr, tOut) into tRc
   end unsafe
   if tRc is not 0 then
      cnxFree(tOut)
      cnxThrow(tRc, "recover")
   end if
   return cnxTake(tOut, tOutLen)
end handler

/* raw SEC1 ECDH: the 32-byte X coordinate of sk * P (no KDF); the shared
   secret is a secret, so its out-block is wiped before deallocation */
public handler cxbEcdh(in pSk as Data, in pPub as Data) returns Data
   variable tRc as Integer
   variable tSkPtr as Pointer
   variable tPubPtr as Pointer
   variable tOut as Pointer
   variable tOutLen as Integer
   variable tSkLen as Integer
   variable tPubLen as Integer
   unsafe
      put _cnx_seckey_len() into tSkLen
      put _cnx_ecdh_secret_len() into tOutLen
   end unsafe
   cnxCheckLen(pSk, tSkLen, "ecdh")
   cnxCheckPubLen(pPub, "ecdh")
   put cnxDataPtr(pSk) into tSkPtr
   put cnxDataPtr(pPub) into tPubPtr
   put cnxDataLen(pPub) into tPubLen
   put cnxAlloc(tOutLen) into tOut
   unsafe
      put _cnx_ecdh(tSkPtr, tPubPtr, tPubLen, tOut) into tRc
      if tRc is not 0 then
         _cnx_wipe(tOut, tOutLen)
      end if
   end unsafe
   if tRc is not 0 then
      cnxFree(tOut)
      cnxThrow(tRc, "ecdh")
   end if
   return cnxTakeSecret(tOut, tOutLen)
end handler

end library
